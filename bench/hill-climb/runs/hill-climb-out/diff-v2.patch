+import pytest
+
+from ratelimit import Config, ConfigError, load_config
+
+
+def test_defaults():
+    assert load_config({}) == Config(rate=1.0, burst=10, window=60.0)
+
+
+def test_values():
+    cfg = load_config({"rate": "2.5", "burst": "4", "window": 30})
+    assert cfg == Config(rate=2.5, burst=4, window=30.0)
+
+
+def test_not_mapping():
+    with pytest.raises(ConfigError):
+        load_config([1, 2])
+
+
+def test_bad_rate_type():
+    with pytest.raises(ConfigError):
+        load_config({"rate": "fast"})
+
+
+def test_zero_rate():
+    with pytest.raises(ConfigError):
+        load_config({"rate": 0})
+
+
+# --- Tests for the README requirement: invalid configuration is rejected ---
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        {"bogus": 1},
+        {"rate": 1, "extra": 2},
+        {"burst": 0},
+        {"burst": -1},
+        {"window": 0},
+        {"window": -5},
+        {"rate": -1},
+        {"rate": "nan"},
+        {"rate": "inf"},
+        {"window": "nan"},
+        {"burst": float("inf")},
+        {"rate": True},
+        {"burst": False},
+        {"window": True},
+        {"burst": 2.9},
+        {"burst": "2.9"},
+        {"burst": None},
+        {"rate": [1]},
+        {"window": {"a": 1}},
+    ],
+)
+def test_invalid_config_rejected(raw):
+    with pytest.raises(ConfigError):
+        load_config(raw)
+
+
+def test_integral_float_burst_accepted():
+    assert load_config({"burst": 4.0}).burst == 4
diff --git a/tests/test_limiter.py b/tests/test_limiter.py
new file mode 100644
index 0000000..649a114
--- /dev/null
+++ b/tests/test_limiter.py
@@ -0,0 +1,181 @@
+from ratelimit import RateLimiter, SlidingWindow
+
+
+class FakeClock:
+    def __init__(self, t=0.0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+    def advance(self, dt):
+        self.t += dt
+
+
+def test_burst_then_deny():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=3, clock=clock)
+    assert [rl.allow("a") for _ in range(4)] == [True, True, True, False]
+
+
+def test_keys_independent():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=1, clock=clock)
+    assert rl.allow("a")
+    assert rl.allow("b")
+    assert not rl.allow("a")
+
+
+def test_refill():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=1, clock=clock)
+    rl.allow("a")
+    clock.advance(1.0)
+    assert rl.allow("a")
+
+
+def test_reset():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=1, clock=clock)
+    assert rl.allow("a")
+    assert not rl.allow("a")
+    rl.reset("a")
+    assert rl.allow("a")
+
+
+def test_stats_counts():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=1, clock=clock)
+    rl.allow("a")
+    rl.allow("a")
+    assert rl.stats == {"allowed": 1, "denied": 1}
+
+
+def test_sliding_window_basic():
+    clock = FakeClock()
+    sw = SlidingWindow(limit=2, window=10.0, clock=clock)
+    assert sw.allow("a")
+    assert sw.allow("a")
+    assert not sw.allow("a")
+    clock.advance(11.0)
+    assert sw.allow("a")
+
+
+def test_sliding_window_reset():
+    clock = FakeClock()
+    sw = SlidingWindow(limit=1, window=10.0, clock=clock)
+    assert sw.allow("a")
+    sw.reset("a")
+    assert sw.allow("a")
+
+
+# --- Tests for the README requirements -----------------------------------
+
+
+def test_fractional_rate_refills_when_polled_faster_than_rate():
+    # rate 0.5/s, burst 1: one request every two seconds, however often polled.
+    clock = FakeClock()
+    rl = RateLimiter(rate=0.5, burst=1, clock=clock)
+    assert rl.allow("a")
+    results = []
+    for _ in range(20):
+        clock.advance(0.25)
+        results.append(rl.allow("a"))
+    # 5 seconds elapsed at 0.5/s => exactly 2 further admissions, at t=2 and t=4.
+    assert results.count(True) == 2
+    assert results[7] is True and results[15] is True
+
+
+def test_sub_second_polling_does_not_starve():
+    clock = FakeClock()
+    rl = RateLimiter(rate=1.0, burst=1, clock=clock)
+    assert rl.allow("a")
+    results = []
+    for _ in range(10):
+        clock.advance(0.5)
+        results.append(rl.allow("a"))
+    assert results == [False, True] * 5
+
+
+def test_refill_capped_at_burst():
+    clock = FakeClock()
+    rl = RateLimiter(rate=10.0, burst=2, clock=clock)
+    assert rl.allow("a") and rl.allow("a")
+    clock.advance(100.0)
+    assert [rl.allow("a") for _ in range(3)] == [True, True, False]
+
+
+def test_fails_closed_when_clock_raises():
+    def broken_clock():
+        raise RuntimeError("no clock")
+
+    rl = RateLimiter(rate=1.0, burst=5, clock=broken_clock)
+    assert rl.allow("a") is False
+    sw = SlidingWindow(limit=5, window=10.0, clock=broken_clock)
+    assert sw.allow("a") is False
+
+
+def test_fails_closed_on_unhashable_key():
+    rl = RateLimiter(rate=1.0, burst=5, clock=FakeClock())
+    assert rl.allow(["unhashable"]) is False
+    sw = SlidingWindow(limit=5, window=10.0, clock=FakeClock())
+    assert sw.allow(["unhashable"]) is False
+
+
+def test_sliding_window_exact_boundary_has_left_window():
+    clock = FakeClock()
+    sw = SlidingWindow(limit=1, window=10.0, clock=clock)
+    assert sw.allow("a")
+    clock.advance(10.0)
+    assert sw.allow("a")
+
+
+def test_sliding_window_inside_window_still_counts():
+    clock = FakeClock()
+    sw = SlidingWindow(limit=1, window=10.0, clock=clock)
+    assert sw.allow("a")
+    clock.advance(9.999)
+    assert not sw.allow("a")
+
+
+def _hammer(limiter, key, threads, calls_per_thread):
+    import threading
+
+    admitted = []
+    barrier = threading.Barrier(threads)
+
+    def worker():
+        n = 0
+        for _ in range(calls_per_thread):
+            if limiter.allow(key):
+                n += 1
+        admitted.append(n)
+
+    def start():
+        barrier.wait()
+        worker()
+
+    ts = [threading.Thread(target=start) for _ in range(threads)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    return sum(admitted)
+
+
+def test_token_bucket_never_over_admits_under_contention():
+    import time
+
+    rl = RateLimiter(rate=0.000001, burst=500, clock=time.monotonic)
+    total = _hammer(rl, "k", threads=16, calls_per_thread=400)
+    assert total == 500
+    assert rl.stats["allowed"] == 500
+    assert rl.stats["allowed"] + rl.stats["denied"] == 16 * 400
+
+
+def test_sliding_window_never_over_admits_under_contention():
+    import time
+
+    sw = SlidingWindow(limit=500, window=3600.0, clock=time.monotonic)
+    total = _hammer(sw, "k", threads=16, calls_per_thread=400)
+    assert total == 500
